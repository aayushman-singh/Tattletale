# Dependencies
node_modules
package-lock.json
yarn.lock
/.aws

# Build outputs
/.next/
/dist/
/build/
/out/
# Ignore scrape outputs but NOT the committed synthetic replay fixtures.
# (Must ignore the *contents* of /output, not /output itself — git cannot
#  re-include a path whose parent directory is excluded.)
/output/*
!/output/golden/
!/output/golden/**
/storage/

# Python
/venv/
__pycache__/
*.pyc
*.pyo

# IDE
.DS_Store
/.vscode
/.vercel
.idea/

# Secrets — NEVER commit. See *.example files for the format.
*.session
*.session-journal
session_*.session*
*.env
.env
.env.*
!.env.example
token.json
drive_token.json
google.json
session.json
client_secret_*.json
*_token.json
service-account.json

