/tests-examples

# Internal helper artifacts
_filter_callback.py

# Scrape caches / crawler state (data, not source)
/scraper/src/Helpers/storage/
/scraper/instagram_data.json
*.json.session

# Replay-mode golden fixtures: re-include AFTER the global *.pdf/*.png ignores
# above so the synthetic demo bundle (including report.pdf) stays committed.
!/output/golden/**
# ...but NOT the CLI scratch output: `generated/` is re-derived on every replay
# run (ephemeral signing key + wall-clock generatedAt). The served bundle lives
# in /frontend/public/demo; this scratch must never be committed.
/output/golden/*/generated/

# Static demo bundle served by the frontend (synthetic, no live scrape).
# Re-include after the global *.pdf ignore so /demo/report.pdf ships.
!/frontend/public/demo/**

# Build output (per-package)
/scraper/dist/
/backend/dist/

# Docs assets (committed screenshots)
!/docs/assets/**

# Playwright MCP scratch
.playwright-mcp/
/frontend/.playwright-mcp/
demo-fullpage.png
graph-only.png
!/docs/assets/*.png
