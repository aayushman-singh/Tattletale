# Tattletale backend (Express + Mongoose). Connects to MongoDB via MONGO_URI.
FROM node:22-alpine
WORKDIR /app

# Install production deps only.
COPY backend/package.json ./
RUN npm install --omit=dev

COPY backend/ ./

ENV NODE_ENV=production
ENV PORT=5001
EXPOSE 5001
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget -qO- http://localhost:5001/api/users >/dev/null 2>&1 || exit 1
CMD ["node", "server.js"]
