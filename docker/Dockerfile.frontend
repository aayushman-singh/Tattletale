# Multi-stage build for the Tattletale React/Vite frontend.
# Stage 1 builds the static bundle; stage 2 serves it with nginx.

# ---- build ----
FROM node:22-alpine AS build
WORKDIR /app

# Install deps first for layer caching.
COPY frontend/package.json ./
RUN npm install

# Build the app. VITE_* vars are baked at build time; pass them with
#   docker build --build-arg VITE_GOOGLE_OAUTH_CLIENT_ID=... (optional — the app
# runs in demo mode without it, see frontend/src/App.jsx).
ARG VITE_GOOGLE_OAUTH_CLIENT_ID=""
ENV VITE_GOOGLE_OAUTH_CLIENT_ID=$VITE_GOOGLE_OAUTH_CLIENT_ID
COPY frontend/ ./
RUN npm run build

# ---- serve ----
FROM nginx:1.27-alpine AS serve
# SPA routing: fall back to index.html so /demo, /login etc. resolve client-side.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' \
    > /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
