{
    "compilerOptions": {
        "module": "esNext",
        "moduleResolution": "node",
        "target": "ES2020",
        "outDir": "dist",
        "esModuleInterop": true, // Interop for CommonJS and ES modules
        "skipLibCheck": true,
        "noUnusedLocals": false,
        "strict": true,
        "lib": ["ES2020", "DOM"],
        "types": ["node"]
    },
    "include": ["./src/**/*", "src/Meta/MetaTimeline.ts"]
}
